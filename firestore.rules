rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // E-posta doğrulanmış kullanıcılar için genel kural
    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Giriş yapan herhangi bir kullanıcı için kontrol
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Profil bilgileri - sadece kendi profilini okuyabilir, kendisi yazabilir
    match /profiller/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Hayvan bilgileri
    match /hayvanlar/{petId} {
      // Okuma: Email verified kullanıcılar
      allow read: if isEmailVerified();
      // Yazma: Sadece sahip olup email verified kullanıcılar
      allow write: if isEmailVerified();
      
      // Pet mesajları - sadece pet sahipleri ve eş sahipleri
      match /messages/{messageId} {
        allow read, write: if isEmailVerified() && 
           exists(/databases/$(database)/documents/hayvanlar/$(petId)) &&
           request.auth.uid in get(/databases/$(database)/documents/hayvanlar/$(petId)).data.owners;
      }
    }
    
    // Pets koleksiyonu - e-posta doğrulanmış kullanıcılar
    match /pets/{petId} {
      allow read, write: if isEmailVerified();
    }
    
    // Ortak sahip istekleri - herhangi bir giriş yapan kullanıcı gönderebilir, email verified olmasa da
    match /co_owner_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.requestedUserId
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.requesterId ||
        request.auth.uid == resource.data.requestedUserId
      );
    }
    
    // Pet mesajları - e-posta doğrulanmış kullanıcılar
    match /pet_messages/{petId} {
      allow read, write: if isEmailVerified();
    }
    
    // Diğer tüm belgeler - e-posta doğrulanmış kullanıcılar
    match /{document=**} {
      allow read, write: if isEmailVerified();
    }
  }
}
